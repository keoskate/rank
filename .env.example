# 🚀 UNIFIED API CONFIGURATION
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git - it contains sensitive credentials!

# ============================================
# POLYGON.IO - Market Data (Required)
# ============================================
# Get your key at: https://polygon.io/dashboard/signup
# Free tier: 5 calls/minute, Paid: unlimited
POLYGON_API_KEY=your_polygon_api_key_here
REACT_APP_POLYGON_API_KEY=your_polygon_api_key_here

# ============================================
# ALPHA VANTAGE - Alternative Market Data (Optional)
# ============================================
# Get your free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 500 API calls per day, 5 calls per minute
REACT_APP_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ============================================
# ALPACA - Paper Trading (Required for trading features)
# ============================================
# Get your keys at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_API_KEY=your_alpaca_paper_api_key_here
ALPACA_PAPER_SECRET_KEY=your_alpaca_paper_secret_key_here

# ============================================
# ALPACA - Live Trading (Optional - CAREFUL!)
# ============================================
# Only fill these in if you want to enable live trading with real money
# Get your keys at: https://app.alpaca.markets/brokerage/dashboard/overview
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# ============================================
# ANTHROPIC CLAUDE - AI Research (Optional)
# ============================================
# Get your key at: https://console.anthropic.com/
# Used for AI-powered stock analysis feature
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# UNUSUAL WHALES - Market Sentiment (Optional)
# ============================================
# Get your key at: https://unusualwhales.com/pricing?product=api
# Used for Market Tide sentiment in experimental analysis
UNUSUAL_WHALES_API_KEY=

# ============================================
# CHEDDARFLOW - Options Flow Data (Optional)
# ============================================
# Your CheddarFlow login credentials
# Used for scraping options flow sentiment data
CHEDDARFLOW_EMAIL=
CHEDDARFLOW_PASSWORD=

# ============================================
# TRADING MODE
# ============================================
# Options: 'paper' (default, safe) or 'live' (real money!)
TRADING_MODE=paper
