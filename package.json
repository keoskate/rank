  "description": "Investments have a score and are ranked in a table",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider node build.js --watch",
    "start": "node ./server/index.js",
    "build": "NODE_OPTIONS=--openssl-legacy-provider node build.js",
    "react-dev": "NODE_OPTIONS=--openssl-legacy-provider node build.js --watch",
    "server-dev": "nodemon server/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code-quality": "npm run lint && npm run format:check",
    "code-fix": "npm run lint:fix && npm run format"
  },
  "repository": "git+https://github.com/keoskate/rank.git",
  "author": "Keion Anvaripour",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/keoskate/rank/issues"
  },
  "homepage": "https://github.com/keoskate/rank#readme",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "body-parser": "^1.18.2",
    "chart.js": "^4.5.0",
    "dotenv": "^17.0.0",
    "express": "^4.16.3",
    "mathjs": "^4.2.2",
    "npm": "^6.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router": "^4.2.0",
    "react-router-dom": "^6.30.1",
    "webpack": "^4.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.30.0",
    "babel-loader": "^8.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "json-loader": "^0.5.7",
    "prettier": "^3.6.2",
    "webpack-cli": "^2.1.2"
