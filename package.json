{
  "name": "rank",
  "version": "1.0.0",
  "description": "Investments have a score and are ranked in a table",
  "main": "index.js",
  "scripts": {
    "dev": "node build.js --watch",
    "start": "node ./server/index.js",
    "build": "node build.js",
    "react-dev": "node build.js --watch",
    "hot-dev": "webpack serve --config webpack.config.js",
    "server-dev": "nodemon --ignore data/ server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code-quality": "npm run lint && npm run format:check",
    "code-fix": "npm run lint:fix && npm run format",
    "prepare": "node scripts/install-hooks.js",
    "check-mvp": "node scripts/check-mvp.js"
  },
  "repository": "git+https://github.com/keoskate/rank.git",
  "author": "Keion Anvaripour",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/keoskate/rank/issues"
  },
  "homepage": "https://github.com/keoskate/rank#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@tanstack/react-table": "^8.21.3",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.10.0",
    "body-parser": "^1.18.2",
    "chart.js": "^4.5.0",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.0.0",
    "express": "^4.16.3",
    "lightweight-charts": "^3.8.0",
    "mathjs": "^4.2.2",
    "multer": "^2.0.2",
    "node-telegram-bot-api": "^0.67.0",
    "npm": "^6.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.30.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "technicalindicators": "^3.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.30.0",
    "babel-loader": "^8.4.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "html-webpack-plugin": "^5.6.5",
    "prettier": "^3.6.2",
    "puppeteer": "^24.32.1",
    "vitest": "^4.1.5",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  }
}
